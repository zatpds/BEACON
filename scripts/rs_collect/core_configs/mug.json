{
    "name": "mug_cleanup",
    "type": "robosuite",
    "experiment": {
        "name": "mug",
        "source": {
            "dataset_path": "data/mug/mug_cleanup.hdf5",
            "filter_key": "valid",
            "n": 10,
            "start": null
        },
        "generation": {
            "path": "scripts/rs_collect/core_datasets/mug_cleanup_real",
            "guarantee": true,
            "keep_failed": true,
            "num_trials": 500,
            "select_src_per_subtask": false,
            "transform_first_robot_pose": false,
            "interpolate_from_last_target_pose": true
        },
        "task": {
            "name": "MugCleanup",
            "robot": null,
            "gripper": null,
            "env_meta_update_kwargs": {},
            "interface": null,
            "interface_type": null
        },
        "max_num_failures": 25,
        "render_video": true,
        "num_demo_to_render": 10,
        "num_fail_demo_to_render": 25,
        "log_every_n_attempts": 50,
        "seed": 1
    },
    "obs": {
        "collect_obs": true,
        "camera_names": [
            "agentview"
        ],
        "camera_height": 96,
        "camera_width": 96
    },
    "task": {
        "task_spec": {
            "subtask_1": {
                "object_ref": "drawer",
                "subtask_term_signal": "open",
                "subtask_term_offset_range": [
                    10,
                    20
                ],
                "selection_strategy": "random",
                "selection_strategy_kwargs": null,
                "action_noise": 0.05,
                "num_interpolation_steps": 5,
                "num_fixed_steps": 0,
                "apply_noise_during_interpolation": false
            },
            "subtask_2": {
                "object_ref": "object",
                "subtask_term_signal": "grasp",
                "subtask_term_offset_range": [
                    10,
                    20
                ],
                "selection_strategy": "random",
                "selection_strategy_kwargs": null,
                "action_noise": 0.05,
                "num_interpolation_steps": 5,
                "num_fixed_steps": 0,
                "apply_noise_during_interpolation": false
            },
            "subtask_3": {
                "object_ref": "drawer",
                "subtask_term_signal": null,
                "subtask_term_offset_range": null,
                "selection_strategy": "random",
                "selection_strategy_kwargs": null,
                "action_noise": 0.05,
                "num_interpolation_steps": 5,
                "num_fixed_steps": 0,
                "apply_noise_during_interpolation": false
            }
        }
    },
    "meta": {
        "hp_base_config_file": "scripts/rs_collect/core_configs/mug.json",
        "hp_keys": [
            "src",
            "task"
        ],
        "hp_values": [
            "mug_cleanup",
            "D0"
        ]
    }
